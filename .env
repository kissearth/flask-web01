# Environment variable overrides for local development

# 设置flask启动的app文件入口
FLASK_APP=autoapp.py
FLASK_DEBUG=1
# 设置为开发环境，flask默认为production
FLASK_ENV=development
GUNICORN_WORKERS=2
LOG_LEVEL=debug
SECRET_KEY='<YourSecretKey>'

# 添加MySQL数据库设置
 MYSQL_HOST='127.0.0.1'
 MYSQL_PORT=3306
 MYSQL_DATABASE='cmdb'
 MYSQL_USER='root'
 MYSQL_PASSWORD='root'

 CACHE_REDIS_HOST=127.0.0.1
 CACHE_REDIS_DB=10
 